<?xml version="1.0"?>
<!-- A UR5-like 6-DOF arm (kinematics follow the classic ur_description UR5 layout). Bundled with ROS2.Net. -->
<robot name="ur5">
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.075" length="0.08"/></geometry></collision>
    <inertial><mass value="4.0"/><inertia ixx="0.0044" ixy="0" ixz="0" iyy="0.0044" iyz="0" izz="0.0072"/></inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.089159" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>
  <link name="shoulder_link">
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.06" length="0.15"/></geometry></collision>
    <inertial><mass value="3.7"/><inertia ixx="0.0103" ixy="0" ixz="0" iyy="0.0103" iyz="0" izz="0.0067"/></inertial>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0.13585 0" rpy="0 1.5707963 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>
  <link name="upper_arm_link">
    <collision><origin xyz="0 0 0.2125"/><geometry><cylinder radius="0.054" length="0.425"/></geometry></collision>
    <inertial><mass value="8.393"/><inertia ixx="0.2269" ixy="0" ixz="0" iyy="0.2269" iyz="0" izz="0.0151"/></inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 -0.1197 0.425" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.15"/>
  </joint>
  <link name="forearm_link">
    <collision><origin xyz="0 0 0.196"/><geometry><cylinder radius="0.04" length="0.392"/></geometry></collision>
    <inertial><mass value="2.275"/><inertia ixx="0.0312" ixy="0" ixz="0" iyy="0.0312" iyz="0" izz="0.0041"/></inertial>
  </link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.39225" rpy="0 1.5707963 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <link name="wrist_1_link">
    <collision><origin xyz="0 0.093 0"/><geometry><sphere radius="0.045"/></geometry></collision>
  </link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0.093 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <link name="wrist_2_link">
    <collision><origin xyz="0 0 0.09465"/><geometry><sphere radius="0.045"/></geometry></collision>
  </link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.09465" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <link name="wrist_3_link">
    <collision><origin xyz="0 0.04 0"/><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
  </link>
  <joint name="tool0_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/><child link="tool0"/>
    <origin xyz="0 0.0823 0" rpy="-1.5707963 0 0"/>
  </joint>
  <link name="tool0"/>
</robot>
