@inherits RosComponentBase
@using ROS2.Net.Msgs.NavMsgs
@using ROS2.Net.Msgs.SensorMsgs
@using ROS2.Net.Perception.Images
@inject IJSRuntime JS

<div class="map rn-card" style="height:@(Height)px">
    <svg @ref="_svg" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet"
         @onwheel="OnWheel" @onpointerdown="OnDown" @onpointermove="OnMove" @onpointerup="OnUp" @onpointerleave="OnLeave">
        @if (_image is not null && _map is not null)
        {
            var info = _map.Info;
            var w = info.Width * info.Resolution;
            var h = info.Height * info.Resolution;
            <image href="@_image" x="@Svg.F(info.Origin.Position.X)" y="@Svg.F(-(info.Origin.Position.Y + h))" width="@Svg.F(w)" height="@Svg.F(h)"
                   preserveAspectRatio="none" style="image-rendering: pixelated" />
        }
        else
        {
            <g><text x="0" y="0" class="empty">@EmptyText</text></g>
        }
        <g transform="scale(1,-1)">
            @if (_path.Count > 1)
            {
                <polyline points="@PathPoints" class="path" />
            }
            @if (Goal is { } g)
            {
                <g transform="@($"translate({Svg.F(g.X)} {Svg.F(g.Y)})")">
                    <circle r="0.25" class="goal-halo" />
                    <circle r="0.08" class="goal" />
                </g>
            }
            @Overlay
            @if (RobotPose is { } p)
            {
                <g transform="@($"translate({Svg.F(p.X)} {Svg.F(p.Y)}) rotate({Svg.F(p.Theta * 180 / Math.PI)})")">
                    <circle r="@Svg.F(RobotRadius)" class="robot-body" />
                    <path d="@($"M {Svg.F(RobotRadius * 1.4)} 0 L 0 {Svg.F(RobotRadius * 0.6)} L 0 {Svg.F(-RobotRadius * 0.6)} Z")" class="robot-dir" />
                </g>
            }
        </g>
    </svg>
    <div class="toolbar">
        <button class="rn-btn" @onclick="() => Zoom(1.4)" aria-label="Zoom in">+</button>
        <button class="rn-btn" @onclick="() => Zoom(1 / 1.4)" aria-label="Zoom out">−</button>
        <button class="rn-btn" @onclick="ResetView" aria-label="Fit map">Fit</button>
    </div>
    @if (_map is not null)
    {
        <div class="meta rn-mono">@_map.Info.Width × @_map.Info.Height · @_map.Info.Resolution.ToString("0.###", CultureInfo.InvariantCulture) m/cell@(_cursor is { } c ? $" · ({c.X:0.00}, {c.Y:0.00})" : "")</div>
    }
</div>

@code {
    private ElementReference _svg;
    private IJSObjectReference? _module;
    private OccupancyGrid? _map;
    private object? _renderedMap;
    private string? _image;
    private List<PlanarPose> _path = [];
    private double _zoom = 1, _panX, _panY;
    private (double X, double Y)? _drag;
    private bool _moved;
    private PlanarPose? _cursor;

    /// <summary>OccupancyGrid topic (latched QoS). Ignored when <see cref="Map"/> is set.</summary>
    [Parameter] public string? Topic { get; set; } = "/map";

    [Parameter] public OccupancyGrid? Map { get; set; }

    /// <summary>nav_msgs/Path topic to overlay, e.g. <c>/plan</c>.</summary>
    [Parameter] public string? PathTopic { get; set; }

    [Parameter] public IReadOnlyList<PlanarPose>? Path { get; set; }

    [Parameter] public PlanarPose? RobotPose { get; set; }

    [Parameter] public double RobotRadius { get; set; } = 0.2;

    [Parameter] public PlanarPose? Goal { get; set; }

    /// <summary>Extra SVG drawn in map coordinates (meters, y up).</summary>
    [Parameter] public RenderFragment? Overlay { get; set; }

    /// <summary>Raised with the clicked map coordinates (a click without dragging).</summary>
    [Parameter] public EventCallback<PlanarPose> OnMapClick { get; set; }

    [Parameter] public int Height { get; set; } = 420;

    [Parameter] public string EmptyText { get; set; } = "Waiting for map…";

    /// <summary>Raster colors (free, occupied, unknown) as #RRGGBB.</summary>
    [Parameter] public string FreeColor { get; set; } = "#1A1D38";

    [Parameter] public string OccupiedColor { get; set; } = "#E9EAF7";

    [Parameter] public string UnknownColor { get; set; } = "#101226";

    private string PathPoints => string.Join(' ', _path.Select(p => $"{Svg.F(p.X)},{Svg.F(p.Y)}"));

    private (double X, double Y, double W, double H) Bounds
    {
        get
        {
            if (_map is null)
            {
                return (-5, -5, 10, 10);
            }

            var i = _map.Info;
            return (i.Origin.Position.X, i.Origin.Position.Y, Math.Max(1, i.Width * i.Resolution), Math.Max(1, i.Height * i.Resolution));
        }
    }

    private string ViewBox
    {
        get
        {
            var (x, y, w, h) = Bounds;
            var vw = w / _zoom;
            var vh = h / _zoom;
            var cx = x + (w / 2) + _panX;
            var cy = y + (h / 2) + _panY;
            return $"{Svg.F(cx - (vw / 2))} {Svg.F(-cy - (vh / 2))} {Svg.F(vw)} {Svg.F(vh)}";
        }
    }

    protected override void OnInitialized()
    {
        if (Map is null && !string.IsNullOrEmpty(Topic))
        {
            Subscribe<OccupancyGrid>(Topic, m => { _map = m; Rasterize(); }, QosProfile.Latched);
        }

        if (Path is null && !string.IsNullOrEmpty(PathTopic))
        {
            Subscribe<ROS2.Net.Msgs.NavMsgs.Path>(PathTopic, m => _path = m.Poses.Select(ps => PlanarPose.FromMsg(ps.Pose)).ToList());
        }
    }

    protected override void OnParametersSet()
    {
        if (Map is not null)
        {
            _map = Map;
            Rasterize();
        }

        if (Path is not null)
        {
            _path = Path.ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ROS2.Net.Blazor/ros2net.js");
                await _module.InvokeVoidAsync("trapWheel", _svg);
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
                // Prerendering or tests without JS.
            }
        }
    }

    private void Rasterize()
    {
        var map = _map;
        if (map is null || ReferenceEquals(map, _renderedMap))
        {
            return;
        }

        var w = (int)map.Info.Width;
        var h = (int)map.Info.Height;
        if (w == 0 || h == 0 || map.Data.Length < w * h)
        {
            return;
        }

        var free = Hex(FreeColor);
        var occ = Hex(OccupiedColor);
        var unk = Hex(UnknownColor);
        var data = new byte[w * h * 3];
        for (var row = 0; row < h; row++)
        {
            var src = (h - 1 - row) * w; // PNG row 0 is the top of the map (largest y).
            var dst = row * w * 3;
            for (var col = 0; col < w; col++)
            {
                var v = map.Data[src + col];
                (byte R, byte G, byte B) c;
                if (v < 0)
                {
                    c = unk;
                }
                else
                {
                    var t = Math.Clamp(v / 100.0, 0, 1);
                    c = ((byte)(free.R + ((occ.R - free.R) * t)), (byte)(free.G + ((occ.G - free.G) * t)), (byte)(free.B + ((occ.B - free.B) * t)));
                }

                data[dst + (col * 3)] = c.R;
                data[dst + (col * 3) + 1] = c.G;
                data[dst + (col * 3) + 2] = c.B;
            }
        }

        var img = new Image { Width = (uint)w, Height = (uint)h, Encoding = "rgb8", Step = (uint)(w * 3), Data = data };
        _image = "data:image/png;base64," + Convert.ToBase64String(Png.Encode(img));
        _renderedMap = map;
    }

    private static (byte R, byte G, byte B) Hex(string hex)
    {
        var s = hex.TrimStart('#');
        return (Convert.ToByte(s[..2], 16), Convert.ToByte(s[2..4], 16), Convert.ToByte(s[4..6], 16));
    }

    private void Zoom(double factor) => _zoom = Math.Clamp(_zoom * factor, 0.5, 40);

    private void ResetView()
    {
        _zoom = 1;
        _panX = _panY = 0;
    }

    private void OnWheel(WheelEventArgs e) => Zoom(e.DeltaY < 0 ? 1.15 : 1 / 1.15);

    private void OnDown(PointerEventArgs e)
    {
        _drag = (e.ClientX, e.ClientY);
        _moved = false;
    }

    private async Task OnMove(PointerEventArgs e)
    {
        if (_drag is { } d)
        {
            var dx = e.ClientX - d.X;
            var dy = e.ClientY - d.Y;
            if (Math.Abs(dx) + Math.Abs(dy) > 3)
            {
                _moved = true;
                var scale = await MetersPerPixel();
                _panX -= dx * scale;
                _panY += dy * scale;
                _drag = (e.ClientX, e.ClientY);
            }
        }
    }

    private async Task OnUp(PointerEventArgs e)
    {
        var wasDrag = _moved;
        _drag = null;
        _moved = false;
        if (!wasDrag && OnMapClick.HasDelegate && await ToWorld(e.OffsetX, e.OffsetY) is { } p)
        {
            _cursor = p;
            await OnMapClick.InvokeAsync(p);
        }
    }

    private void OnLeave(PointerEventArgs e) => _drag = null;

    private async Task<double> MetersPerPixel()
    {
        var size = await Size();
        var (_, _, w, h) = Bounds;
        if (size.Width <= 0 || size.Height <= 0)
        {
            return 0.02;
        }

        return Math.Max(w / _zoom / size.Width, h / _zoom / size.Height);
    }

    private async Task<PlanarPose?> ToWorld(double offsetX, double offsetY)
    {
        var size = await Size();
        if (size.Width <= 0 || size.Height <= 0)
        {
            return null;
        }

        var (x, y, w, h) = Bounds;
        var vw = w / _zoom;
        var vh = h / _zoom;
        var scale = Math.Min(size.Width / vw, size.Height / vh); // "meet"
        var padX = (size.Width - (vw * scale)) / 2;
        var padY = (size.Height - (vh * scale)) / 2;
        var cx = x + (w / 2) + _panX;
        var cy = y + (h / 2) + _panY;
        var wx = cx - (vw / 2) + ((offsetX - padX) / scale);
        var wy = cy + (vh / 2) - ((offsetY - padY) / scale);
        return new PlanarPose(wx, wy);
    }

    private async Task<(double Width, double Height)> Size()
    {
        if (_module is null)
        {
            return (0, 0);
        }

        var r = await _module.InvokeAsync<ElementSize>("rect", _svg);
        return (r.Width, r.Height);
    }

    private sealed record ElementSize(double Width, double Height);

    protected override async ValueTask DisposeCoreAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
