@inherits RosComponentBase
@using ROS2.Net.Msgs.SensorMsgs

<div class="battery" style="width:@(Size)px">
    <svg viewBox="0 0 120 120" width="@Size" height="@Size" role="img" aria-label="@($"Battery {Pct:0}%")">
        <circle cx="60" cy="60" r="50" class="track" />
        <circle cx="60" cy="60" r="50" class="value @Level" stroke-dasharray="@Svg.F(Dash) 400" transform="rotate(-90 60 60)" />
        <text x="60" y="64" class="pct">@(double.IsNaN(_percentage) ? "—" : $"{Pct:0}%")</text>
        <text x="60" y="84" class="sub">@(_voltage > 0 ? $"{_voltage:0.0} V" : Label)</text>
    </svg>
</div>

@code {
    private double _percentage = double.NaN;
    private double _voltage;

    /// <summary>sensor_msgs/BatteryState topic. Ignored when <see cref="Percentage"/> is set.</summary>
    [Parameter] public string? Topic { get; set; }

    /// <summary>State of charge in [0, 1].</summary>
    [Parameter] public double? Percentage { get; set; }

    [Parameter] public int Size { get; set; } = 140;

    [Parameter] public string Label { get; set; } = "battery";

    private double Pct => Math.Clamp(_percentage, 0, 1) * 100;

    private double Dash => double.IsNaN(_percentage) ? 0 : Math.Clamp(_percentage, 0, 1) * 2 * Math.PI * 50;

    private string Level => _percentage < 0.2 ? "low" : _percentage < 0.5 ? "mid" : "high";

    protected override void OnInitialized()
    {
        if (Percentage is null && !string.IsNullOrEmpty(Topic))
        {
            Subscribe<BatteryState>(Topic, m =>
            {
                _percentage = m.Percentage;
                _voltage = m.Voltage;
            });
        }
    }

    protected override void OnParametersSet()
    {
        if (Percentage is { } p)
        {
            _percentage = p;
        }
    }
}
