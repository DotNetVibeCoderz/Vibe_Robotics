<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ROS2.Net.AppGen</RootNamespace>
    <Description>Backend of ROS2.Net App Generator (ROS2AppGen): Jack - The Code Bender (Semantic Kernel agent with project, build, ROS2.Net knowledge and web tools), project templates, build/run/deploy and code formatting.</Description>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0070;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Message types for the knowledge tools (list_message_types / get_message_type). -->
    <ProjectReference Include="..\ROS2.Net.Core\ROS2.Net.Core.csproj" />
    <ProjectReference Include="..\ROS2.Net.Msgs\ROS2.Net.Msgs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library's own docs, linked so Jack's reference answers stay in sync with the repo. -->
    <EmbeddedResource Include="..\..\docs\en\*.md" LogicalName="docs/%(Filename)%(Extension)" Visible="false" />
    <!-- Reflected public API of the ROS2.Net libraries (regenerated by a test, see ApiSurfaceTests). -->
    <EmbeddedResource Include="Knowledge\api\*.txt" LogicalName="api/%(Filename)%(Extension)" />
    <!-- Project templates: Templates/<id>/template.json + files. -->
    <EmbeddedResource Include="Templates\**\*" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="Templates\**" />
    <None Remove="Templates\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ROS2.Net.AppGen.Tests" />
  </ItemGroup>

</Project>
