{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gravicode Studios (Kang Fadhil)",
  "classifications": [ "ROS2.Net", "Robotics", "ROS 2", "Console" ],
  "identity": "ROS2.Net.Templates.Node",
  "name": "ROS2.Net Node",
  "description": "A ROS 2 application with talker and listener nodes running on the .NET Generic Host.",
  "shortName": "ros2net-node",
  "sourceName": "Ros2NetNode",
  "defaultName": "MyRobot",
  "tags": { "language": "C#", "type": "project" },
  "preferNameDirectory": true,
  "symbols": {
    "rmw": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "rtps", "description": "Managed DDS-RTPS: talks to ROS 2 nodes on the network." },
        { "choice": "inprocess", "description": "In-process middleware: no network, zero copy." },
        { "choice": "rosbridge", "description": "rosbridge WebSocket (ws://localhost:9090)." }
      ],
      "defaultValue": "rtps",
      "replaces": "RMW_IDENTIFIER",
      "description": "Default middleware written to appsettings.json."
    },
    "rosVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0",
      "replaces": "ROS2NET_VERSION",
      "description": "ROS2.Net package version."
    }
  }
}
