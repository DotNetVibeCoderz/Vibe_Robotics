<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ROS2.Net.Core" Version="ROS2NET_VERSION" />
    <PackageReference Include="ROS2.Net.Msgs" Version="ROS2NET_VERSION" />
    <PackageReference Include="ROS2.Net.Rosidl.Generator" Version="ROS2NET_VERSION" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every file under interfaces/<package>/{msg,srv,action}/ becomes a C# type at compile time. -->
    <RosInterface Include="interfaces/**/*.msg;interfaces/**/*.srv;interfaces/**/*.action" />
  </ItemGroup>

</Project>
